# Docker PostgreSQL: copy this file to both .env (Docker Compose) and .env.local (Next.js)
POSTGRES_DB=23hotel
POSTGRES_USER=hotel_app
POSTGRES_PASSWORD=hotel_local_dev_password_change_me
POSTGRES_PORT=55432
DATABASE_URL=postgresql://hotel_app:hotel_local_dev_password_change_me@localhost:55432/23hotel

# Local session signing (development only). Use a unique random secret with 32+ characters in production.
SESSION_SECRET=local-dev-only-replace-this-with-a-random-32-character-secret
SESSION_MAX_AGE_SECONDS=604800
STAFF_SESSION_MAX_AGE_SECONDS=28800
OTP_SECRET=local-dev-otp-salt-change-before-production
AUTH_OTP_MODE=development
DEV_OTP_CODE=123456

# Hotel details
NEXT_PUBLIC_HOTEL_NAME=23 Hotel & Residence
NEXT_PUBLIC_HOTEL_ADDRESS=No. 25, Set Hmu Street 1, Myittarnyunt Ward, Tamwe Township, Yangon 11211, Myanmar
NEXT_PUBLIC_HOTEL_LAT=16.8661
NEXT_PUBLIC_HOTEL_LNG=96.1951
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Booking deposit. Customer pays this percentage after the hotel confirms the reservation.
BOOKING_DEPOSIT_PERCENT=30
NEXT_PUBLIC_BOOKING_DEPOSIT_PERCENT=30

# Public URL required for provider callbacks in production; use HTTPS and a real domain.
# Keep provider secrets server-side only. Never use NEXT_PUBLIC_ prefix for secret keys.
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYMENT_RETURN_URL=http://localhost:3000/payment/return

# MMQR via MyanMyanPay (obtain approved merchant credentials from the provider).
MMPAY_APP_ID=
MMPAY_PUBLISHABLE_KEY=
MMPAY_SECRET_KEY=
MMPAY_API_BASE_URL=

# Hosted wallets/banks/cards checkout via Dinger. Enable individual methods in the merchant portal.
# Methods like KBZPay, WavePay, AYA Pay, CB Pay, MPU, Visa and Mastercard depend on account approval.
DINGER_MODE=staging
DINGER_CLIENT_ID=
DINGER_PUBLIC_KEY=
DINGER_KEY_FOR_ENCRYPTION=
DINGER_MERCHANT_KEY=
DINGER_PROJECT_NAME=
DINGER_MERCHANT_NAME=23 Hotel & Residence
DINGER_HMAC_SECRET=
DINGER_CALLBACK_KEY=

# Optional generic HMAC webhook compatibility for any future custom provider.
PAYMENT_WEBHOOK_SECRET=

# SMS provider. Required for real OTP and booking notifications in production.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=23Hotel
