# Replace with your Windows PC's LAN IPv4 address when testing on a physical phone.
# Example: http://192.168.1.25:3000
# Android Emulator usually uses: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://192.168.1.25:3000
EXPO_PUBLIC_HOTEL_NAME=23 Hotel & Residence
EXPO_PUBLIC_HOTEL_ADDRESS=Enter your hotel address, Yangon, Myanmar
EXPO_PUBLIC_HOTEL_LAT=16.8661
EXPO_PUBLIC_HOTEL_LNG=96.1951

# Deposit percentage displayed in the mobile app; server remains authoritative.
# Display only; the server calculates the authoritative deposit amount.
EXPO_PUBLIC_BOOKING_DEPOSIT_PERCENT=30
